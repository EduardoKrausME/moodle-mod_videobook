{{!
    @template mod_videobook/report

    Per-chapter analytics and per-student Video Book progress.

    Example context (json):
    {
        "name": "Video Book",
        "studentcount": 82,
        "chapteranalytics": [{
            "number": 1,
            "title": "Introduction",
            "completed": 67,
            "inprogress": 8,
            "notstarted": 7
        }]
    }
}}
<div class="videobook-report">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-0">{{#str}}reporttitle, videobook{{/str}}</h2>
            <div class="text-muted">{{name}} · {{studentcount}} {{#str}}student, videobook{{/str}}</div>
        </div>
        <a class="btn btn-outline-secondary" href="{{{viewurl}}}">{{#str}}backtobook, videobook{{/str}}</a>
    </div>

    {{^haschapters}}
        <div class="alert alert-info">{{#str}}nochaptersteacher, videobook{{/str}}</div>
    {{/haschapters}}

    {{#haschapters}}
        <section class="mb-4">
            <h3 class="h5">{{#str}}chapteranalytics, videobook{{/str}}</h3>
            <div class="table-responsive">
                <table class="table table-sm align-middle videobook-chapter-analytics">
                    <thead>
                        <tr>
                            <th>{{#str}}chaptertitle, videobook{{/str}}</th>
                            <th>{{#str}}completedcount, videobook{{/str}}</th>
                            <th>{{#str}}inprogresscount, videobook{{/str}}</th>
                            <th>{{#str}}notstartedcount, videobook{{/str}}</th>
                            <th>{{#str}}chapterprogress, videobook{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#chapteranalytics}}
                            <tr>
                                <td><strong>{{number}}. {{title}}</strong></td>
                                <td>{{completed}}</td>
                                <td>{{inprogress}}</td>
                                <td>{{notstarted}}</td>
                                <td>{{averagepercent}}%</td>
                            </tr>
                        {{/chapteranalytics}}
                    </tbody>
                </table>
            </div>
        </section>

        {{^hasrows}}
            <div class="alert alert-info">{{#str}}nostudents, videobook{{/str}}</div>
        {{/hasrows}}

        {{#hasrows}}
            <div class="table-responsive videobook-report-table-wrap">
                <table class="table table-bordered table-hover align-middle videobook-report-table">
                    <thead>
                        <tr>
                            <th>{{#str}}student, videobook{{/str}}</th>
                            {{#chapterheaders}}<th title="{{title}}">{{number}}. {{title}}</th>{{/chapterheaders}}
                            <th>{{#str}}overall, videobook{{/str}}</th>
                            <th>{{#str}}lastaccess, videobook{{/str}}</th>
                            {{#canreset}}<th>{{#str}}actions, videobook{{/str}}</th>{{/canreset}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                <td>
                                    <strong>{{fullname}}</strong>
                                    <div class="small text-muted">{{email}}</div>
                                </td>
                                {{#chapters}}
                                    <td>
                                        <span class="videobook-report-state {{#statuscompleted}}is-complete{{/statuscompleted}}">
                                            {{statustext}}
                                        </span>
                                        {{#hasvideo}}<div class="small">{{percent}}%</div>{{/hasvideo}}
                                        {{#hasposition}}<div class="small text-muted">{{positiontext}}</div>{{/hasposition}}
                                    </td>
                                {{/chapters}}
                                <td>
                                    <strong>{{overallpercent}}%</strong>
                                    <div class="small text-muted">{{completed}}/{{chaptercount}}</div>
                                </td>
                                <td>{{lastaccess}}</td>
                                {{#canreset}}
                                    <td>
                                        <a class="btn btn-sm btn-outline-danger" href="{{{reseturl}}}">
                                            {{#str}}resetprogress, videobook{{/str}}
                                        </a>
                                    </td>
                                {{/canreset}}
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        {{/hasrows}}
    {{/haschapters}}
</div>
