{{!
    @template mod_videobook/view

    Video Book student view with sections, native transcript, structured materials and configurable lesson layout.

    Example context (json):
    {
        "name": "Video Book",
        "bookpercent": 37,
        "chaptertitle": "Configuration",
        "layouttabs": true,
        "hasvideo": true
    }
}}
<div class="videobook" data-region="videobook" data-config="{{configjson}}">
    <header class="videobook-header">
        <div>
            <h2 class="mb-1">{{name}}</h2>
            <div class="text-muted">
                {{#str}}bookprogress, videobook{{/str}}:
                <strong data-region="book-percent">{{bookpercent}}%</strong>
            </div>
        </div>
        <div class="videobook-header-actions">
            {{#canmanage}}
                <a class="btn btn-outline-secondary" href="{{{manageurl}}}">
                    {{#str}}managechapters, videobook{{/str}}
                </a>
            {{/canmanage}}
            {{#canreport}}
                <a class="btn btn-outline-secondary" href="{{{reporturl}}}">
                    {{#str}}viewreport, videobook{{/str}}
                </a>
            {{/canreport}}
        </div>
    </header>

    {{#hasintro}}<div class="videobook-intro">{{{intro}}}</div>{{/hasintro}}

    {{#showcontinue}}
        <div class="videobook-continue">
            <div>
                <div class="small text-muted">{{#str}}continuestudying, videobook{{/str}}</div>
                <strong>{{chaptertitle}}</strong>
                <span class="text-muted"> · {{continuepercent}}%</span>
                {{#hascontinueposition}}
                    <span class="text-muted"> · {{continuestoppedtext}}</span>
                {{/hascontinueposition}}
            </div>
        </div>
    {{/showcontinue}}

    <div class="videobook-layout">
        <aside class="videobook-sidebar" aria-label="{{#str}}chapters, videobook{{/str}}">
            <form class="videobook-search" action="{{{searchurl}}}" method="get">
                <input type="hidden" name="id" value="{{cmid}}">
                <label class="visually-hidden" for="videobook-search-{{cmid}}">
                    {{#str}}searchchapters, videobook{{/str}}
                </label>
                <div class="input-group input-group-sm">
                    <input id="videobook-search-{{cmid}}" class="form-control" type="search" name="q"
                           value="{{searchquery}}" placeholder="{{#str}}searchchapters, videobook{{/str}}">
                    <button class="btn btn-outline-secondary" type="submit">⌕</button>
                </div>
            </form>

            {{#hassearch}}
                <div class="videobook-search-results">
                    <h3>{{#str}}searchresults, videobook{{/str}}</h3>
                    {{#hassearchresults}}
                        <ul class="list-unstyled mb-0">
                            {{#searchresults}}
                                <li class="videobook-search-result">
                                    {{#locked}}
                                        <span class="d-block text-muted">🔒 {{title}}</span>
                                    {{/locked}}
                                    {{^locked}}
                                        <a href="{{{url}}}">{{title}}</a>
                                    {{/locked}}
                                    {{#hassection}}<div class="small text-muted">{{section}}</div>{{/hassection}}
                                    {{#hasexcerpt}}<div class="small">{{excerpt}}</div>{{/hasexcerpt}}
                                </li>
                            {{/searchresults}}
                        </ul>
                    {{/hassearchresults}}
                    {{^hassearchresults}}
                        <div class="small text-muted">{{#str}}noresults, videobook{{/str}}</div>
                    {{/hassearchresults}}
                </div>
            {{/hassearch}}

            <div class="videobook-sidebar-chapters">
                {{#navsections}}
                    <section class="videobook-nav-section">
                        {{#hastitle}}<h3 class="videobook-nav-section-title">{{title}}</h3>{{/hastitle}}
                        <ol class="videobook-chapter-list">
                            {{#items}}
                                <li class="videobook-chapter-item {{#current}}is-current{{/current}} {{#locked}}is-locked{{/locked}}">
                                    {{#locked}}
                                        <span class="videobook-chapter-link" aria-disabled="true">
                                            <span class="videobook-chapter-thumb">
                                                {{#hasimage}}<img src="{{{imageurl}}}" alt="">{{/hasimage}}
                                                {{^hasimage}}<span>{{number}}</span>{{/hasimage}}
                                            </span>
                                            <span class="videobook-chapter-name">{{title}}</span>
                                            <span class="videobook-status">{{statusicon}} {{statustext}}</span>
                                        </span>
                                    {{/locked}}
                                    {{^locked}}
                                        <div class="videobook-chapter-link">
                                            <span class="videobook-chapter-thumb">
                                                {{#hasimage}}<img src="{{{imageurl}}}" alt="">{{/hasimage}}
                                                {{^hasimage}}<span>{{number}}</span>{{/hasimage}}
                                            </span>
                                            <a class="videobook-chapter-name" href="{{{url}}}">{{title}}</a>
                                            <span class="videobook-status {{#statuscompleted}}is-complete{{/statuscompleted}}">
                                                {{statusicon}} {{statustext}}
                                                {{#statusinprogress}} · {{percent}}%{{/statusinprogress}}
                                            </span>
                                        </div>
                                    {{/locked}}
                                </li>
                            {{/items}}
                        </ol>
                    </section>
                {{/navsections}}
            </div>
        </aside>

        <main class="videobook-main">
            <div class="videobook-chapter-heading">
                <div>
                    <div class="text-muted">{{chapterpositiontext}}</div>
                    <h3 class="mb-0">{{chaptertitle}}</h3>
                </div>
                {{#hasvideo}}
                    <div>
                        {{#str}}chapterprogress, videobook{{/str}}:
                        <strong data-region="chapter-percent">{{currentpercent}}%</strong>
                    </div>
                {{/hasvideo}}
            </div>

            {{#layouttabs}}
                {{#hasvideo}}
                    <div class="videobook-player-wrap">
                        {{#html5}}
                            <video class="videobook-player" data-region="html5-player" controls playsinline preload="metadata">
                                <source src="{{{videourl}}}">
                                {{#captions}}
                                    <track kind="subtitles" label="{{label}}" srclang="{{srclang}}" src="{{{url}}}">
                                {{/captions}}
                            </video>
                        {{/html5}}
                        {{#youtube}}<div class="videobook-embed" data-region="youtube-player"></div>{{/youtube}}
                        {{#vimeo}}<div class="videobook-embed" data-region="vimeo-player"></div>{{/vimeo}}
                    </div>
                {{/hasvideo}}

                {{#hastabs}}
                    <div class="videobook-tabs" data-region="lesson-tabs">
                        <div class="videobook-tab-list" role="tablist">
                            {{#tabs}}
                                <button type="button" class="videobook-tab {{#active}}is-active{{/active}}"
                                        role="tab" data-tab-target="{{id}}"
                                        aria-selected="{{#active}}true{{/active}}{{^active}}false{{/active}}">
                                    {{label}}
                                </button>
                            {{/tabs}}
                        </div>
                        <div class="videobook-tab-panels">
                            {{#tabs}}
                                <section class="videobook-tab-panel {{^active}}d-none{{/active}}"
                                         role="tabpanel" data-tab-panel="{{id}}">
                                    {{#iscontent}}
                                        {{#hasimage}}<img class="videobook-chapter-image" src="{{{imageurl}}}" alt="">{{/hasimage}}
                                        {{#haschaptertext}}<div class="videobook-content">{{{chaptertext}}}</div>{{/haschaptertext}}
                                    {{/iscontent}}
                                    {{#istranscript}}
                                        <div class="videobook-transcript">{{{transcript}}}</div>
                                    {{/istranscript}}
                                    {{#ismaterials}}
                                        <div class="videobook-material-grid">
                                            {{#materials}}
                                                <a class="videobook-material" href="{{{url}}}"
                                                   {{#external}}target="_blank" rel="noopener noreferrer"{{/external}}
                                                   {{#download}}download{{/download}}>
                                                    <span class="videobook-material-type">{{typelabel}}</span>
                                                    <strong>{{title}}</strong>
                                                    {{#hasdescription}}<span>{{description}}</span>{{/hasdescription}}
                                                </a>
                                            {{/materials}}
                                        </div>
                                    {{/ismaterials}}
                                </section>
                            {{/tabs}}
                        </div>
                    </div>
                {{/hastabs}}
            {{/layouttabs}}

            {{#layoutcontinuous}}
                <div class="videobook-continuous">
                    {{#blocks}}
                        {{#isvideo}}
                            {{#hasvideo}}
                                <div class="videobook-player-wrap">
                                    {{#html5}}
                                        <video class="videobook-player" data-region="html5-player" controls playsinline preload="metadata">
                                            <source src="{{{videourl}}}">
                                            {{#captions}}
                                                <track kind="subtitles" label="{{label}}" srclang="{{srclang}}" src="{{{url}}}">
                                            {{/captions}}
                                        </video>
                                    {{/html5}}
                                    {{#youtube}}<div class="videobook-embed" data-region="youtube-player"></div>{{/youtube}}
                                    {{#vimeo}}<div class="videobook-embed" data-region="vimeo-player"></div>{{/vimeo}}
                                </div>
                            {{/hasvideo}}
                        {{/isvideo}}

                        {{#iscontent}}
                            {{#hascontent}}
                                <section class="videobook-section-block">
                                    <h4>{{#str}}chaptertext, videobook{{/str}}</h4>
                                    {{#hasimage}}<img class="videobook-chapter-image" src="{{{imageurl}}}" alt="">{{/hasimage}}
                                    {{#haschaptertext}}<div class="videobook-content">{{{chaptertext}}}</div>{{/haschaptertext}}
                                </section>
                            {{/hascontent}}
                        {{/iscontent}}

                        {{#istranscript}}
                            {{#hastranscript}}
                                <section class="videobook-section-block">
                                    <h4>{{#str}}transcript, videobook{{/str}}</h4>
                                    <div class="videobook-transcript">{{{transcript}}}</div>
                                </section>
                            {{/hastranscript}}
                        {{/istranscript}}

                        {{#ismaterials}}
                            {{#hasmaterials}}
                                <section class="videobook-section-block">
                                    <h4>{{#str}}materials, videobook{{/str}}</h4>
                                    <div class="videobook-material-grid">
                                        {{#materials}}
                                            <a class="videobook-material" href="{{{url}}}"
                                               {{#external}}target="_blank" rel="noopener noreferrer"{{/external}}
                                               {{#download}}download{{/download}}>
                                                <span class="videobook-material-type">{{typelabel}}</span>
                                                <strong>{{title}}</strong>
                                                {{#hasdescription}}<span>{{description}}</span>{{/hasdescription}}
                                            </a>
                                        {{/materials}}
                                    </div>
                                </section>
                            {{/hasmaterials}}
                        {{/ismaterials}}
                    {{/blocks}}
                </div>
            {{/layoutcontinuous}}

            {{#cancomplete}}
                <button type="button" class="btn btn-primary mt-3" data-action="complete-text">
                    {{#str}}markchaptercomplete, videobook{{/str}}
                </button>
            {{/cancomplete}}

            {{#currentcompleted}}
                <div class="alert alert-success mt-3" data-region="completion-message">
                    {{#str}}chaptercompleted, videobook{{/str}}
                </div>
            {{/currentcompleted}}
            {{^currentcompleted}}
                <div class="alert alert-success mt-3 d-none" data-region="completion-message">
                    {{#str}}chaptercompleted, videobook{{/str}}
                </div>
            {{/currentcompleted}}
            <div class="alert alert-warning mt-3 d-none" data-region="tracking-message" role="status"></div>

            <nav class="videobook-prev-next" aria-label="{{#str}}chapternavigation, videobook{{/str}}">
                <div>
                    {{#hasprevious}}
                        <a class="btn btn-outline-primary" href="{{{previousurl}}}">
                            ← {{#str}}previous, videobook{{/str}}
                        </a>
                    {{/hasprevious}}
                </div>
                <div>
                    {{#hasnext}}
                        <a class="btn btn-primary" href="{{{nexturl}}}">
                            {{#str}}next, videobook{{/str}} →
                        </a>
                    {{/hasnext}}
                    {{#nextlocked}}
                        <button type="button" class="btn btn-primary" disabled data-region="locked-next"
                                data-next-url="{{{nextunlockurl}}}">
                            {{#str}}nextlocked, videobook{{/str}} 🔒
                        </button>
                    {{/nextlocked}}
                </div>
            </nav>
        </main>
    </div>
</div>
