{{!
    @template mod_videobook/manage

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
{{!
    Chapter management list.
}}
<div class="videobook-manage">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div><h2 class="mb-0">{{#str}}managechapters, videobook{{/str}}</h2>
            <div class="text-muted">{{name}}</div>
        </div>
        <div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="{{{viewurl}}}">{{#str}}
            backtobook, videobook{{/str}}</a><a class="btn btn-primary" href="{{{addurl}}}">{{#str}}
            addchapter, videobook{{/str}}</a></div>
    </div>
    {{#haschapters}}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>#</th>
                    <th>{{#str}}chaptertitle, videobook{{/str}}</th>
                    <th>{{#str}}videosource, videobook{{/str}}</th>
                    <th>{{#str}}minimumpercent, videobook{{/str}}</th>
                    <th>{{#str}}actions, videobook{{/str}}</th>
                </tr>
                </thead>
                <tbody>
                {{#chapters}}
                    <tr>
                        <td>{{number}}</td>
                        <td>{{title}}</td>
                        <td>{{source}}</td>
                        <td>{{minimumpercent}}</td>
                        <td class="videobook-actions">
                            {{#canup}}<a class="btn btn-sm btn-outline-secondary" href="{{{upurl}}}"
                                         aria-label="{{#str}}moveup, videobook{{/str}}">↑</a>{{/canup}}
                            {{#candown}}<a class="btn btn-sm btn-outline-secondary" href="{{{downurl}}}"
                                           aria-label="{{#str}}movedown, videobook{{/str}}">↓</a>{{/candown}}
                            <a class="btn btn-sm btn-outline-primary" href="{{{editurl}}}">{{#str}}
                                edit, videobook{{/str}}</a>
                            <a class="btn btn-sm btn-outline-danger" href="{{{deleteurl}}}">{{#str}}
                                delete, videobook{{/str}}</a>
                        </td>
                    </tr>
                {{/chapters}}
                </tbody>
            </table>
        </div>
    {{/haschapters}}
    {{^haschapters}}
        <div class="alert alert-info">{{#str}}nochaptersteacher, videobook{{/str}}</div>{{/haschapters}}
</div>
